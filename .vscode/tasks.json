{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure firmware",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Build firmware",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--parallel"
            ],
            "dependsOn": [
                "Configure firmware"
            ],
            "dependsOrder": "sequence",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "OpenOCD: Flash project (SWD)",
            "type": "process",
            "command": "${workspaceFolder}/scripts/flash.sh",
            "args": [
                "${workspaceFolder}/build/bustepper.elf"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Build + Flash",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build firmware",
                "OpenOCD: Flash project (SWD)"
            ],
            "problemMatcher": [],
            "runOptions": {
                "instanceLimit": 1
            }
        }
    ]
}
